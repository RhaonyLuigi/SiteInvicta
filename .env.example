NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Para produção, use uma conexão PostgreSQL com pooling.
DATABASE_URL=
# Apenas desenvolvimento local permite PostgreSQL embutido e pagamento de teste.
LOCAL_DATABASE_PATH=.data/postgres
PAYMENT_PROVIDER=mock
# E-mail de quem configura as comissões da plataforma.
PLATFORM_OWNER_EMAIL=owner@invicta.test
# Vazio mantém a comissão pendente. 0 é uma escolha explícita.
PLATFORM_FEE_BPS=
# included desconta a comissão do organizador. added acrescenta ao total.
PLATFORM_FEE_MODE=included
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
# sandbox ou production
MERCADOPAGO_ENV=sandbox
RESEND_API_KEY=
EMAIL_FROM=
# Identifique o responsável por Web Push, por exemplo mailto:contato@seu-dominio.com
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Segredo para /api/jobs. Use um valor aleatório longo.
CRON_SECRET=
