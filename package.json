{
  "name": "invicta",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/dev.js",
    "start": "node --env-file-if-exists=.env server/dev.js",
    "build": "node scripts/build.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "jobs": "node --env-file-if-exists=.env scripts/jobs.js",
    "push:keys": "node scripts/push-keys.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "stripe": "^23.1.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@stripe/stripe-js": "^10.2.1"
  }
}
